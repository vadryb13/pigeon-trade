# CI временно отключён — идёт рефакторинг тестов (DRY моков).
# Вернуть после завершения: переименовать обратно в CI или просто удалить префикс "DISABLED-".
# name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["3.11", "3.12", "3.13"]

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: pip

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          # Все extras — иначе storage/embedding/cache тесты молча отключаются (TESTS-4)
          pip install -e ".[dev,llm,data,embeddings,screener]"
          # T-Invest gRPC — закрытый PyPI T-Bank
          pip install t-tech-investments --index-url https://opensource.tbank.ru/api/v4/projects/238/packages/pypi/simple
          pip install pytest-cov

      - name: Lint with ruff
        # Без `|| true` — ошибки линтера падают CI (TESTS-3)
        run: |
          ruff check aqr/ tests/

      - name: Run tests with coverage gating
        # Coverage >= 80% (TESTS-2)
        run: |
          PYTHONPATH=. pytest tests/ -v --tb=short --cov=aqr --cov-report=term-missing --cov-fail-under=80
