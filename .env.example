# === ОБЯЗАТЕЛЬНЫЕ для старта (validate_runtime()) ===

# Postgres (используется и в alembic/env.py, и в aqr/db.py)
DATABASE_URL=postgresql+asyncpg://postgres:aqr@localhost:5432/aqr

# Мастер-ключ для HMAC WS-токенов и Fernet-шифрования per-session credentials.
# В проде ОБЯЗАТЕЛЬНО задать случайный ≥32 символов:
#   export AQR_SESSION_SECRET="$(openssl rand -base64 32)"
AQR_SESSION_SECRET=

# === Per-session credentials (вводятся через UI: /chat/{token}/settings) ===
# Эти переменные ОПЦИОНАЛЬНЫ в env — сервер не стартует без них,
# но при их отсутствии требует заполнить через форму /settings.
#
# AQR_LLM_MODEL=                  # claude-3-5-sonnet-20241022, gpt-4o-mini, gigachat/GigaChat-Pro
# ANTHROPIC_API_KEY=              # для claude-*
# OPENAI_API_KEY=                 # для gpt-* или для эмбеддингов (text-embedding-3-small)
# GIGACHAT_CREDENTIALS=           # для gigachat-*
# INVEST_TOKEN=                   # t-Invest gRPC token

# === Опциональные (дефолты в коде) ===

# Sandbox vs production T-Invest target (INVEST_SANDBOX=1 для dev/CI)
# INVEST_SANDBOX=1

# OHLCV-кэш: дефолт ~/.aqr/ohlcv_cache.duckdb
# AQR_CACHE_DIR=/path/to/cache/dir

# Структурированное логирование (иначе human-readable)
# AQR_LOG_JSON=1

# CORS (для прода ОБЯЗАТЕЛЬНО переопределить). По умолчанию — wildcard "*".
# AQR_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
# AQR_ALLOWED_METHODS=GET,POST

# Background task retention: лимит одновременных pipeline-тасков (PERF-1)
# AQR_MAX_BACKGROUND_TASKS=64

# SSL в РФ-окружении (если падает проверка корневых CA)
# SSL_TBANK_VERIFY=True