# LLM (все опциональны — без ключей работает fallback-планировщик и fallback-нарратор)
AQR_LLM_MODEL=              # e.g. claude-3-5-sonnet-20241022, gpt-4o-mini, gigachat/GigaChat-Pro
ANTHROPIC_API_KEY=
OPENAI_API_KEY=             # также используется для эмбеддингов (Embedder)
GIGACHAT_CREDENTIALS=       # если используешь GigaChat

# Postgres (используется и в alembic/env.py, и в aqr/db.py)
DATABASE_URL=postgresql+asyncpg://postgres:aqr@localhost:5432/aqr

# OHLCV-кэш (опционально — DuckDB-файл, дефолт ~/.aqr/ohlcv_cache.duckdb)
# AQR_CACHE_DIR=/path/to/cache/dir

# Структурированное логирование (опционально — иначе human-readable)
# AQR_LOG_JSON=1

# CORS (для прода ОБЯЗАТЕЛЬНО переопределить). По умолчанию — wildcard "*".
# AQR_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
# AQR_ALLOWED_METHODS=GET,POST

# WebSocket auth: подпись session_id через HMAC (SEC-1).
# В проде ОБЯЗАТЕЛЬНО задать — иначе HS256-ключ генерируется на каждый процесс
# и клиенты теряют сессии при рестарте.
# AQR_SESSION_SECRET=<random-32-bytes-base64>

# Background task retention: лимит одновременных pipeline-тасков (PERF-1)
# AQR_MAX_BACKGROUND_TASKS=64
